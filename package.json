{
  "name": "pi-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:mcp-bridge && tsc -b && vite build",
    "build:mcp-bridge": "node scripts/build-mcp-bridge.mjs",
    "pretauri": "npm install --no-audit --no-fund && npm run build:mcp-bridge",
    "test:e2e": "npm run test:e2e:build && npm run test:e2e:run",
    "test:e2e:build": "tsc -b && vite build --mode e2e && TAURI_CONFIG='{\"build\":{\"devUrl\":null}}' cargo build --manifest-path src-tauri/Cargo.toml --release --features webdriver",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
