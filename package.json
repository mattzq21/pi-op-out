{
  "name": "piop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "bun run setup:dependencies",
    "dev": "bun --bun vite",
    "prebuild": "bun run setup:dependencies",
    "build": "bun scripts/build-app.mjs",
    "prebuild:icons": "bun run setup:dependencies",
    "build:icons": "bun scripts/build-icons.mjs",
    "prebuild:extensions": "bun run setup:dependencies",
    "build:extensions": "bun scripts/build-extensions.mjs",
    "prebuild:backend-scripts": "bun run setup:dependencies",
    "build:backend-scripts": "bun scripts/build-extensions.mjs --only backend-scripts",
    "setup:dependencies": "bun scripts/setup-dependencies.mjs",
    "pretauri": "bun run setup:dependencies",
    "tauri": "bun scripts/tauri.mjs",
    "prebuild:mobile": "bun run setup:dependencies",
    "build:mobile": "bun scripts/build-frontend.mjs --mode mobile",
    "mobile": "python3 \"$HOME/.agents/skills/mobile-piop/scripts/setup-debug.py\" --project .",
    "prebuild:daemon": "bun run setup:dependencies",
    "build:daemon": "bun scripts/build-daemon.mjs --install",
    "daemon": "bun run build:daemon && target/release/piopd start",
    "daemon:stop": "target/release/piopd stop",
    "daemon:restart": "bun run build:daemon && bun run daemon:stop && target/release/piopd start",
    "predaemon:dev": "bun run setup:dependencies",
    "daemon:dev": "bun scripts/build-daemon.mjs --debug && target/debug/piopd start",
    "daemon:dev:stop": "target/debug/piopd stop",
    "predaemon:dev:restart": "bun run setup:dependencies",
    "daemon:dev:restart": "bun scripts/build-daemon.mjs --debug && bun run daemon:dev:stop && target/debug/piopd start",
    "android:sync": "bun run build:mobile && bun --bun cap sync android",
    "android:open": "bun run android:sync && bun --bun cap open android",
    "android:build": "bun run android:sync && cd clients/android && ./gradlew assembleDebug",
    "android:debug-connection": "bun scripts/mobile-debug-connection.mjs",
    "reinstall": "bun scripts/reinstall-mobile.mjs",
    "test:mobile": "python3 scripts/test-run.py node --test test/mobile/*.test.mjs",
    "test:unit": "python3 scripts/test-run.py node scripts/test-unit.mjs test/unit/*.test.mjs",
    "test:extensions": "python3 scripts/test-run.py sh -c 'node --test --test-timeout=120000 test/extensions/*.test.mjs && bun test ./extensions'",
    "test:runner": "python3 test/runner/cleanup.test.py && python3 scripts/test-run.py node --test test/runner/*.test.mjs",
    "test:daemon": "python3 scripts/test-run.py node scripts/test-daemon.mjs",
    "test:rust": "python3 scripts/test-run.py env TAURI_CONFIG='{\"bundle\":{\"externalBin\":[]}}' cargo test --locked -p piop-desktop -- --test-threads=1",
    "test:mobile:ui": "python3 scripts/test-run.py node test/mobile-ui.mjs",
    "test:e2e": "python3 scripts/test-run.py node scripts/test-e2e.mjs",
    "test:e2e:build": "node scripts/test-e2e.mjs --build --list"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@solid-primitives/keyed": "^1.5.3",
    "@tauri-apps/api": "^2.8.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "dbus-next": "0.10.2",
    "dompurify": "^3.3.0",
    "lucide-solid": "^0.468.0",
    "marked": "^17.0.0",
    "mermaid": "^11.17.2",
    "solid-js": "^1.9.15",
    "typebox": "1.3.27",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@capacitor/cli": "^8.5.2",
    "@tauri-apps/cli": "^2.8.0",
    "@types/bun": "^1.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "babel-preset-solid": "^1.9.12",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "25.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-solid": "^2.11.14"
  }
}
