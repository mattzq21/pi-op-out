{
  "name": "piop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "lint:rust": "npm run build:extensions && vite build && cd src-tauri && cargo clippy --locked --all-targets --all-features -- -D warnings",
    "build": "npm run build:extensions && tsc -b && vite build",
    "build:voice": "node scripts/build-voice.mjs",
    "build:extensions": "npm run build:mcp-bridge && npm run build:codex-compaction && npm run build:fast-mode",
    "build:fast-mode": "node scripts/build-fast-mode.mjs",
    "build:codex-compaction": "node scripts/build-codex-compaction.mjs",
    "build:mcp-bridge": "node scripts/build-mcp-bridge.mjs",
    "pretauri": "npm install --no-audit --no-fund && npm run build:extensions",
    "test:extensions": "node --test test/extensions/*.test.mjs",
    "test:mutation": "stryker run",
    "test:mutation:rust": "npm run build && node scripts/mutate-rust.mjs",
    "test:e2e": "npm run test:e2e:build && npm run test:e2e:run",
    "test:e2e:build": "npm run build:extensions && tsc -b && vite build --mode e2e && TAURI_CONFIG='{\"build\":{\"devUrl\":null},\"app\":{\"windows\":[{\"title\":\"piop\",\"width\":1440,\"height\":900,\"minWidth\":900,\"minHeight\":640,\"focus\":false,\"decorations\":false,\"transparent\":false}]}}' cargo build --manifest-path src-tauri/Cargo.toml --release --features webdriver",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "test:e2e:manual": "node scripts/wdio-manual.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
