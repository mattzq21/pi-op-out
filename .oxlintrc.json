{
  "categories": { "correctness": "off" },
  "plugins": ["oxc", "typescript"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-mobile/**",
    "android/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "src-tauri/resources/*.bundle.mjs",
    ".stryker-tmp/**",
    "reports/**",
    "**/mutants.out/**",
    "**/mutants.out.old/**",
    "vite.config.js",
    "vite.config.d.ts",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "local", "specifier": "./scripts/oxlint-local.mjs" }
  ],
  "rules": {
    "local/no-comments": "error",
    "local/no-assertions": "error",
    "complexity": ["error", { "max": 10, "variant": "classic" }],
    "max-lines": ["error", { "max": 750, "skipComments": true }],
    "no-unused-vars": ["error", { "args": "all", "argsIgnorePattern": "^_", "caughtErrors": "all", "caughtErrorsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "no-unreachable": "error",
    "no-unused-labels": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["extensions/piop-runtime-settings/provider-accounts.mjs", "src-tauri/resources/provider-sdk.mjs"],
      "rules": {
        "no-unused-vars": "off",
        "local/daemon-shared-bindings": "error",
        "local/daemon-no-unused-vars": ["error", { "args": "all", "argsIgnorePattern": "^_", "caughtErrors": "all", "caughtErrorsIgnorePattern": "^_", "ignoreRestSiblings": true }]
      }
    }
  ]
}
