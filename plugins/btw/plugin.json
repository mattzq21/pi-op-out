{
  "id": "btw",
  "name": "Side chats",
  "extension": {
    "after": "session"
  },
  "commands": {
    "btw": "immediateWithImages"
  },
  "keybinds": [
    {
      "id": "open",
      "label": "Open side chat",
      "description": "Start a /btw side chat for the current conversation",
      "defaultShortcut": "Ctrl+Alt+S",
      "command": "btw",
      "needsMessages": true
    }
  ],
  "auxiliary": {
    "label": "Btw",
    "letter": "B",
    "color": "#6d8fb8"
  }
}
