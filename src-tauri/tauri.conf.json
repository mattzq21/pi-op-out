{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi",
  "version": "0.1.0",
  "identifier": "dev.pi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Pi", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 640, "focus": true, "decorations": true, "transparent": false, "dragDropEnabled": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
