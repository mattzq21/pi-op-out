{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "bun"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "useUnknownInCatchVariables": false,
    "resolveJsonModule": true,
    "paths": {
      "@earendil-works/*": [
        "../target/pi-modules/@earendil-works/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "resources/**/*.ts"
  ]
}
